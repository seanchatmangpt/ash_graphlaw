# Diataxis documentation map for ash_graphlaw.
# UNSUPPORTED(generator-capability): hand-written. sa2a-diataxis-pack was not run in
# this wave, so this file is a handwritten projection of the documentation contract
# and carries no generator receipt.
@prefix dx:   <https://diataxis.fr/ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix agl:  <https://graphlaw.dev/ash/docs#> .

dx:Tutorial    a rdfs:Class ; rdfs:label "Tutorial" .
dx:HowTo       a rdfs:Class ; rdfs:label "How-to guide" .
dx:Reference   a rdfs:Class ; rdfs:label "Reference" .
dx:Explanation a rdfs:Class ; rdfs:label "Explanation" .

agl:path a rdfs:Property ; rdfs:label "repository-relative path" .
agl:provenance a rdfs:Property ; rdfs:label "generated or hand" .

agl:documentation_README_md a dx:Explanation ;
    rdfs:label "Documentation index" ;
    agl:path "documentation/README.md" ;
    agl:provenance "hand" .

