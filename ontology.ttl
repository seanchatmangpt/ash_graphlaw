    glx:docsUrl "https://hexdocs.pm/ash_graphlaw" ;
    glx:dateReleased "2026-10-01" ;
    glx:coverageThreshold 80 ;
    glx:abiVersion 1 ;
    glx:wasmSha256 "7bb2a7e5ebcef7584b0b960451272d56fa75414d76a12138d41e8973e126eee0" ;
    glx:wasmAsset "graphlaw.wasm" ;
    glx:wasmUrl "https://github.com/seanchatmangpt/graphlaw/releases/download/v26.9.29/graphlaw.wasm" ;
