# SPDX-FileCopyrightText: 2026 ash_graphlaw contributors <https://github.com/seanchatmangpt/ash_graphlaw/graphs/contributors>
#
# SPDX-License-Identifier: MIT
#
# ash_graphlaw source ontology (L01). Sources only; every generated file is a projection.
#
# Recorded choice (read from ash-extension-pack templates/install.ex.tmpl): the
# aex:installerRuntimeDep literal is the PIPE form "<dep>|<version_req>" -- the template
# splits on "|" (split(pat="|") first/last) and renders
# Igniter.Project.Deps.add_dep({:wasmex, "~> 0.15"}). The space form ("wasmex ~> 0.15"
# shown in the pack's rdfs:comment) would render a garbage dep tuple, so it is NOT used.
#
# Doctrine: GraphLaw derives and validates; it never authorizes. Nothing in this ontology
# grants authority. Standing is derived from results, never stored on the DSL.
#
# Broken-term assignment (Chatman failure taxonomy). Digest/import-surface/ABI/wasm-shape
# codes -> R_missing_identity. Lease/ceiling/trusted-key codes -> R_missing_authority.
# Engine and host refusals on the input itself -> mu_on_O. Host runtime failures that
# leave an admission with no observed consequence -> R_missing_consequence. Steps or
# admissions that would admit vacuously -> admission_vacuous. Unclassified future engine
# variants -> R_missing_standing (standing cannot be assigned).

@prefix aex:  <http://seanchatmangpt.github.io/packs/ash-extension-core#> .
@prefix gac:  <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#> .
@prefix glx:  <https://graphlaw.dev/ash#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Vocabulary
#################################################################

glx:Project a rdfs:Class ; rdfs:label "The ash_graphlaw package: version and upstream pins." .
glx:RefusalCode a rdfs:Class ; rdfs:label "One member of the closed typed-refusal code table." .
glx:Standing a rdfs:Class ; rdfs:label "One standing atom from the operating doctrine vocabulary." .
glx:WasiImport a rdfs:Class ; rdfs:label "One WASI preview1 import function the engine may declare (closed allowlist)." .
glx:UnsupportedResidue a rdfs:Class ; rdfs:label "One hand-written element no pack capability emits: UNSUPPORTED(generator-capability), ledgered in HANDWRITTEN.md." .
glx:VersionBinding a rdfs:Class ; rdfs:label "One file that carries a literal copy of the package or engine version (drift tripwire)." .

glx:packageVersion a rdf:Property ; rdfs:domain glx:Project ; rdfs:comment "calver of this package." .
glx:graphLawVersion a rdf:Property ; rdfs:domain glx:Project ; rdfs:comment "pinned GraphLaw release tag." .
glx:abiVersion a rdf:Property ; rdfs:domain glx:Project ; rdfs:comment "GraphLaw WASM ABI_VERSION this library speaks." .
glx:wasmSha256 a rdf:Property ; rdfs:domain glx:Project ; rdfs:comment "sha256 of the released graphlaw.wasm asset." .
glx:wasmAsset a rdf:Property ; rdfs:domain glx:Project ; rdfs:comment "release asset file name." .
glx:wasmUrl a rdf:Property ; rdfs:domain glx:Project ; rdfs:comment "download URL of the pinned release asset." .
glx:maintainer a rdf:Property ; rdfs:domain glx:Project ; rdfs:comment "package maintainer name as published to Hex." .
glx:repositoryUrl a rdf:Property ; rdfs:domain glx:Project ; rdfs:comment "canonical source repository URL." .
glx:docsUrl a rdf:Property ; rdfs:domain glx:Project ; rdfs:comment "published documentation URL (HexDocs)." .
glx:dateReleased a rdf:Property ; rdfs:domain glx:Project ; rdfs:comment "ISO 8601 release date of packageVersion." .
glx:coverageThreshold a rdf:Property ; rdfs:domain glx:Project ; rdfs:comment "minimum line coverage percentage the test gate enforces." .
glx:engineReleaseTag a rdf:Property ; rdfs:domain glx:Project ; rdfs:comment "GraphLaw release tag with its leading v, exactly as spelled in the release URL." .
glx:marketplaceSha a rdf:Property ; rdfs:domain glx:Project ; rdfs:comment "ggen-marketplace commit the packs are materialized from." .
glx:registrySha256 a rdf:Property ; rdfs:domain glx:Project ; rdfs:comment "registry_sha256 of the vendored priv/graphlaw/capability-registry.json (DIGEST RULE, graphlaw.capability-registry/1); rewritten by scripts/import_registry.sh." .
glx:registryFile a rdf:Property ; rdfs:domain glx:Project ; rdfs:comment "repository-relative path of the vendored capability registry JSON." .
glx:ggenSha a rdf:Property ; rdfs:domain glx:Project ; rdfs:comment "ggen commit the generator identity is pinned to." .
glx:residuePath a rdf:Property ; rdfs:domain glx:UnsupportedResidue ; rdfs:comment "repository-relative path of the hand-written file." .
glx:residueElement a rdf:Property ; rdfs:domain glx:UnsupportedResidue ; rdfs:comment "the module, task or file element that is hand-written." .
glx:residueCapability a rdf:Property ; rdfs:domain glx:UnsupportedResidue ; rdfs:comment "the generator capability that does not exist." .
glx:residueOwnerPack a rdf:Property ; rdfs:domain glx:UnsupportedResidue ; rdfs:comment "the pack that would own the capability." .
glx:residueDate a rdf:Property ; rdfs:domain glx:UnsupportedResidue ; rdfs:comment "ISO 8601 date the gap was last observed." .
glx:residueLedger a rdf:Property ; rdfs:domain glx:UnsupportedResidue ; rdfs:comment "ledger file that must carry a row for residuePath." .
glx:bindingPath a rdf:Property ; rdfs:domain glx:VersionBinding ; rdfs:comment "repository-relative path of the file carrying the literal." .
glx:bindingKind a rdf:Property ; rdfs:domain glx:VersionBinding ; rdfs:comment "closed: package | engine." .
glx:bindingValue a rdf:Property ; rdfs:domain glx:VersionBinding ; rdfs:comment "the version literal the file must carry." .
glx:codeName a rdf:Property ; rdfs:domain glx:RefusalCode .
glx:codeClass a rdf:Property ; rdfs:domain glx:RefusalCode ; rdfs:comment "closed: refused_identity | refused_structure | refused_authority | refused_admission | blocked_resource | unsupported." .
glx:codeSource a rdf:Property ; rdfs:domain glx:RefusalCode ; rdfs:comment "closed: engine | host | ash." .
glx:codeDoc a rdf:Property ; rdfs:domain glx:RefusalCode .
glx:brokenTerm a rdf:Property ; rdfs:domain glx:RefusalCode ; rdfs:comment "Chatman failure-taxonomy term the refusal names." .
glx:codeOrder a rdf:Property ; rdfs:domain glx:RefusalCode ; rdfs:comment "unique integer; fixes rendering order." .
glx:standingName a rdf:Property ; rdfs:domain glx:Standing .
glx:standingDoc a rdf:Property ; rdfs:domain glx:Standing .
glx:standingOrder a rdf:Property ; rdfs:domain glx:Standing .
glx:importName a rdf:Property ; rdfs:domain glx:WasiImport ; rdfs:comment "function name inside wasi_snapshot_preview1." .
glx:importParams a rdf:Property ; rdfs:domain glx:WasiImport ; rdfs:comment "comma-separated wasm value types of the parameters (empty string for none)." .
glx:importResults a rdf:Property ; rdfs:domain glx:WasiImport ; rdfs:comment "comma-separated wasm value types of the results (empty string for none)." .

#################################################################
# Project facts and pins
#################################################################

