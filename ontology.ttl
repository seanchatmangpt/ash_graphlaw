#################################################################
# Version literal bindings (drift tripwire, gates/070)
#
# Each file below carries a literal copy of a version. gates/070 refuses a binding whose
# value differs from glx:packageVersion (kind package) or glx:graphLawVersion / the
# engineReleaseTag (kind engine). scripts/ggen_sync.sh --check-versions verifies the real
# files on disk.
#################################################################

