    glx:registryFile "priv/graphlaw/capability-registry.json" ;
    glx:registrySha256 "sha256:8f3ef15bad35fc095e4a832b4cca945414e90152c485dc5a5a92d2ff0f804e16" ;
    glx:ggenSha "ff96f04e8c7b851e5cca53f3faf5ce1d5f43ce6e" .

#################################################################
# Capability op bindings (consumer-supplied; graphlaw does not emit these)
#
# gac:OpBinding rows tell the graphlaw-ash-capability pack how this package binds each
# registry op. Legacy ops (capabilities sniff law hooks) keep their root-API shapes; their
# typed equivalents live only at AshGraphLaw.Capability.API. law decodes to the existing
# AshGraphLaw.Admitted instead of a generated Result module.
#################################################################

glx:OpBindingCapabilities a gac:OpBinding ; gac:bindingOp "capabilities" ; gac:bindingLegacy true .
glx:OpBindingSniff a gac:OpBinding ; gac:bindingOp "sniff" ; gac:bindingLegacy true .
glx:OpBindingParse a gac:OpBinding ; gac:bindingOp "parse" ; gac:bindingLegacy false .
glx:OpBindingConvert a gac:OpBinding ; gac:bindingOp "convert" ; gac:bindingLegacy false .
glx:OpBindingCanonical a gac:OpBinding ; gac:bindingOp "canonical" ; gac:bindingLegacy false .
glx:OpBindingSparql a gac:OpBinding ; gac:bindingOp "sparql" ; gac:bindingLegacy false .
glx:OpBindingShacl a gac:OpBinding ; gac:bindingOp "shacl" ; gac:bindingLegacy false .
glx:OpBindingShex a gac:OpBinding ; gac:bindingOp "shex" ; gac:bindingLegacy false .
glx:OpBindingN3 a gac:OpBinding ; gac:bindingOp "n3" ; gac:bindingLegacy false .
glx:OpBindingEntail a gac:OpBinding ; gac:bindingOp "entail" ; gac:bindingLegacy false .
glx:OpBindingDatalog a gac:OpBinding ; gac:bindingOp "datalog" ; gac:bindingLegacy false .
glx:OpBindingHooks a gac:OpBinding ; gac:bindingOp "hooks" ; gac:bindingLegacy true .
glx:OpBindingLaw a gac:OpBinding ; gac:bindingOp "law" ; gac:bindingResultModule "AshGraphLaw.Admitted" ; gac:bindingLegacy true .
glx:OpBindingPolicy a gac:OpBinding ; gac:bindingOp "policy" ; gac:bindingLegacy false .

#################################################################
# Engine import allowlist (least privilege)
#
# The engine is a compute-only module: the host gives it no preopens, args, env or pipes.
# EngineLoad refuses any import outside this set, by module, name AND type. Observed on the
# GraphLaw wasm build at /Users/sac/graphlaw (Wasmex.Module.imports, 2026-09-29); not
# observed on the pinned release asset, which this session could not fetch (UNKNOWN). A
# lawful engine that needs another function is refused with the offender named; extend
# these rows, never the loader.
#################################################################

glx:ImportClockTimeGet a glx:WasiImport ; glx:importName "clock_time_get" ; glx:importParams "i32,i64,i32" ; glx:importResults "i32" .
glx:ImportEnvironGet a glx:WasiImport ; glx:importName "environ_get" ; glx:importParams "i32,i32" ; glx:importResults "i32" .
glx:ImportEnvironSizesGet a glx:WasiImport ; glx:importName "environ_sizes_get" ; glx:importParams "i32,i32" ; glx:importResults "i32" .
glx:ImportFdWrite a glx:WasiImport ; glx:importName "fd_write" ; glx:importParams "i32,i32,i32,i32" ; glx:importResults "i32" .
glx:ImportProcExit a glx:WasiImport ; glx:importName "proc_exit" ; glx:importParams "i32" ; glx:importResults "" .
glx:ImportRandomGet a glx:WasiImport ; glx:importName "random_get" ; glx:importParams "i32,i32" ; glx:importResults "i32" .
glx:ImportSchedYield a glx:WasiImport ; glx:importName "sched_yield" ; glx:importParams "" ; glx:importResults "i32" .

#################################################################
# ash-extension-pack spec: AshGraphLaw.Resource
#
# Optional string/module fields carry NO aex:fieldDefault: the pack renders the literal into the
# Spark schema, and Spark rejects `default: nil` for :string and :module types. Omitting it
# leaves the struct field and the option default at nil.
#################################################################

glx:AshGraphLawSpec a aex:AshExtensionSpec ;
    aex:packageName "ash_graphlaw" ;
    aex:moduleName "AshGraphLaw.Resource" ;
    aex:extensionTarget "resource" ;
    aex:singleExtensionKind "ash_graphlaw" ;
    aex:taskModuleName "AshGraphlaw" ;
    aex:formatterModule "AshGraphLaw.Formatter" ;
    aex:installerRuntimeDep "wasmex|~> 0.15" ;
    aex:workflowReactor false ;
    aex:workflowReversible false ;
    aex:generatesReceiptedAction false ;
    aex:dualLevelFixture false ;
    aex:validateDelegateModule "AshGraphLaw.Contract" ;
    aex:validateDelegateFunction "validate" .

glx:AshGraphLawGraphlawSection a aex:DslSection ;
    aex:sectionOf glx:AshGraphLawSpec ;
    aex:sectionName "graphlaw" ;
    aex:sectionOrder 1 ;
    aex:sectionDescribe "GraphLaw admission configuration: one runtime entity and any number of named admissions." ;
    aex:singletonEntityKey "runtime" .

# --- entity :runtime (singleton, no args) ---

glx:AshGraphLawRuntimeEntity a aex:DslEntity ;
    aex:entityOf glx:AshGraphLawGraphlawSection ;
    aex:entityOrder 1 ; aex:entityName "runtime" ;
    aex:entityStruct "AshGraphLaw.Dsl.Runtime" .

glx:AshGraphLawRuntimeWasmPath a aex:EntitySchemaField ;
    aex:fieldOf glx:AshGraphLawRuntimeEntity ;
    aex:fieldOrder 1 ; aex:fieldName "wasm_path" ; aex:fieldType "string" ;
    aex:fieldRequired false ;
    aex:fieldDoc "Path to a graphlaw.wasm file. Nil uses the resolution order in AshGraphLaw.WasmConfig; the digest pin still applies to the vendored path." .

glx:AshGraphLawRuntimeTimeout a aex:EntitySchemaField ;
    aex:fieldOf glx:AshGraphLawRuntimeEntity ;
    aex:fieldOrder 2 ; aex:fieldName "timeout_ms" ; aex:fieldType "integer" ;
    aex:fieldRequired false ; aex:fieldDefault "5000" ;
    aex:fieldDoc "Per-call timeout in milliseconds. Must be positive." .

glx:AshGraphLawRuntimeSkew a aex:EntitySchemaField ;
    aex:fieldOf glx:AshGraphLawRuntimeEntity ;
    aex:fieldOrder 3 ; aex:fieldName "max_skew_secs" ; aex:fieldType "integer" ;
    aex:fieldRequired false ; aex:fieldDefault "60" ;
    aex:fieldDoc "Allowed clock skew in seconds when the engine checks a lease. Must not be negative." .

glx:AshGraphLawRuntimeTrustedKeys a aex:EntitySchemaField ;
    aex:fieldOf glx:AshGraphLawRuntimeEntity ;
    aex:fieldOrder 4 ; aex:fieldName "trusted_keys" ; aex:fieldType "list_string" ;
    aex:fieldRequired false ; aex:fieldDefault "[]" ;
    aex:fieldDoc "Hex-encoded 32-byte public keys (64 characters each) whose lease signatures the engine may accept." .

# --- entity :admission (arg :name, identifier :name) ---

glx:AshGraphLawAdmissionEntity a aex:DslEntity ;
    aex:entityOf glx:AshGraphLawGraphlawSection ;
    aex:entityOrder 2 ; aex:entityName "admission" ;
    aex:entityStruct "AshGraphLaw.Dsl.Admission" ;
    aex:entityIdentifier "name" .

glx:AshGraphLawAdmissionArgName a aex:EntityArg ;
    aex:argOf glx:AshGraphLawAdmissionEntity ; aex:argOrder 1 ; aex:argName "name" .

glx:AshGraphLawAdmissionName a aex:EntitySchemaField ;
    aex:fieldOf glx:AshGraphLawAdmissionEntity ;
    aex:fieldOrder 1 ; aex:fieldName "name" ; aex:fieldType "atom" ;
    aex:fieldRequired true ;
    aex:fieldDoc "Unique name of the admission within the resource." .

glx:AshGraphLawAdmissionStep a aex:EntitySchemaField ;
    aex:fieldOf glx:AshGraphLawAdmissionEntity ;
    aex:fieldOrder 2 ; aex:fieldName "step" ; aex:fieldType "one_of" ;
    aex:fieldRequired true ;
    aex:fieldDoc "The GraphLaw law step this admission runs." .

glx:AshGraphLawStepShacl a aex:FieldOneOfValue ; aex:oneOfValueOf glx:AshGraphLawAdmissionStep ; aex:oneOfValueOrder 1 ; aex:oneOfValueName "shacl" .
glx:AshGraphLawStepN3 a aex:FieldOneOfValue ; aex:oneOfValueOf glx:AshGraphLawAdmissionStep ; aex:oneOfValueOrder 2 ; aex:oneOfValueName "n3" .
glx:AshGraphLawStepRdfs a aex:FieldOneOfValue ; aex:oneOfValueOf glx:AshGraphLawAdmissionStep ; aex:oneOfValueOrder 3 ; aex:oneOfValueName "rdfs" .
glx:AshGraphLawStepOwlRl a aex:FieldOneOfValue ; aex:oneOfValueOf glx:AshGraphLawAdmissionStep ; aex:oneOfValueOrder 4 ; aex:oneOfValueName "owl_rl" .
glx:AshGraphLawStepHooks a aex:FieldOneOfValue ; aex:oneOfValueOf glx:AshGraphLawAdmissionStep ; aex:oneOfValueOrder 5 ; aex:oneOfValueName "hooks" .
glx:AshGraphLawStepPlan a aex:FieldOneOfValue ; aex:oneOfValueOf glx:AshGraphLawAdmissionStep ; aex:oneOfValueOrder 6 ; aex:oneOfValueName "plan" .
glx:AshGraphLawStepRequireReceipt a aex:FieldOneOfValue ; aex:oneOfValueOf glx:AshGraphLawAdmissionStep ; aex:oneOfValueOrder 7 ; aex:oneOfValueName "require_receipt" .
glx:AshGraphLawStepRequireSignedReceipt a aex:FieldOneOfValue ; aex:oneOfValueOf glx:AshGraphLawAdmissionStep ; aex:oneOfValueOrder 8 ; aex:oneOfValueName "require_signed_receipt" .

glx:AshGraphLawAdmissionCeiling a aex:EntitySchemaField ;
    aex:fieldOf glx:AshGraphLawAdmissionEntity ;
    aex:fieldOrder 3 ; aex:fieldName "ceiling" ; aex:fieldType "one_of" ;
    aex:fieldRequired false ; aex:fieldDefault ":construct" ;
    aex:fieldDoc "Highest authority ceiling the caller's lease must reach before the engine is consulted. Admission itself never grants authority." .

glx:AshGraphLawCeilingObserve a aex:FieldOneOfValue ; aex:oneOfValueOf glx:AshGraphLawAdmissionCeiling ; aex:oneOfValueOrder 1 ; aex:oneOfValueName "observe" .
glx:AshGraphLawCeilingSelect a aex:FieldOneOfValue ; aex:oneOfValueOf glx:AshGraphLawAdmissionCeiling ; aex:oneOfValueOrder 2 ; aex:oneOfValueName "select" .
glx:AshGraphLawCeilingConstruct a aex:FieldOneOfValue ; aex:oneOfValueOf glx:AshGraphLawAdmissionCeiling ; aex:oneOfValueOrder 3 ; aex:oneOfValueName "construct" .

glx:AshGraphLawAdmissionLaw a aex:EntitySchemaField ;
    aex:fieldOf glx:AshGraphLawAdmissionEntity ;
    aex:fieldOrder 4 ; aex:fieldName "law" ; aex:fieldType "module" ;
    aex:fieldRequired false ;
    aex:fieldDoc "Module implementing AshGraphLaw.Law that supplies the step payload for this admission." .

glx:AshGraphLawAdmissionProjection a aex:EntitySchemaField ;
    aex:fieldOf glx:AshGraphLawAdmissionEntity ;
    aex:fieldOrder 5 ; aex:fieldName "projection" ; aex:fieldType "module" ;
    aex:fieldRequired false ;
    aex:fieldDoc "Module implementing AshGraphLaw.Projection that turns the subject into RDF data. Nil uses AshGraphLaw.Projection.Default." .

# --- entity :capability (arg :name, identifier :name) ---
# Declares which GraphLaw registry ops a resource may run through the typed capability API.
# Name legality and ceiling floor are enforced by the hand-written verifier (Contract /
# Authority.op_ceiling/1); a resource declaring none allows every op (back-compat).

glx:AshGraphLawCapabilityEntity a aex:DslEntity ;
    aex:entityOf glx:AshGraphLawGraphlawSection ;
    aex:entityOrder 3 ; aex:entityName "capability" ;
    aex:entityStruct "AshGraphLaw.Dsl.Capability" ;
    aex:entityIdentifier "name" .

glx:AshGraphLawCapabilityArgName a aex:EntityArg ;
    aex:argOf glx:AshGraphLawCapabilityEntity ; aex:argOrder 1 ; aex:argName "name" .

glx:AshGraphLawCapabilityName a aex:EntitySchemaField ;
    aex:fieldOf glx:AshGraphLawCapabilityEntity ;
    aex:fieldOrder 1 ; aex:fieldName "name" ; aex:fieldType "atom" ;
    aex:fieldRequired true ;
    aex:fieldDoc "Registry op name this resource declares (for example :sparql or :shacl). Must be a name in AshGraphLaw.Capability.Registry.names/0." .

glx:AshGraphLawCapabilityCeiling a aex:EntitySchemaField ;
    aex:fieldOf glx:AshGraphLawCapabilityEntity ;
    aex:fieldOrder 2 ; aex:fieldName "ceiling" ; aex:fieldType "one_of" ;
    aex:fieldRequired false ; aex:fieldDefault ":observe" ;
    aex:fieldDoc "Authority ceiling declared for this capability. Must not be below the ceiling the op needs (observe for read-only ops, construct for n3, entail, datalog, hooks, law). Declaring a ceiling never grants authority." .

glx:AshGraphLawCapabilityCeilingObserve a aex:FieldOneOfValue ; aex:oneOfValueOf glx:AshGraphLawCapabilityCeiling ; aex:oneOfValueOrder 1 ; aex:oneOfValueName "observe" .
glx:AshGraphLawCapabilityCeilingSelect a aex:FieldOneOfValue ; aex:oneOfValueOf glx:AshGraphLawCapabilityCeiling ; aex:oneOfValueOrder 2 ; aex:oneOfValueName "select" .
glx:AshGraphLawCapabilityCeilingConstruct a aex:FieldOneOfValue ; aex:oneOfValueOf glx:AshGraphLawCapabilityCeiling ; aex:oneOfValueOrder 3 ; aex:oneOfValueName "construct" .

glx:AshGraphLawCapabilityDoc a aex:EntitySchemaField ;
    aex:fieldOf glx:AshGraphLawCapabilityEntity ;
    aex:fieldOrder 3 ; aex:fieldName "doc" ; aex:fieldType "string" ;
    aex:fieldRequired false ;
    aex:fieldDoc "Free-text note on why the resource declares this capability." .

#################################################################
# Package license (pack templates/LICENSE.tmpl; gate 070)
#################################################################

glx:AshGraphLawLicense a aex:PackageLicenseFile ;
    aex:licensePackage "ash_graphlaw" ;
    aex:licenseSpdx "MIT" ;
    aex:licenseCopyrightLine "Copyright (c) 2026 ash_graphlaw contributors" .

#################################################################
# Typed refusal codes (closed table, 40 codes)
#################################################################

glx:CodeNotAdmitted a glx:RefusalCode ;
    glx:codeName "not_admitted" ; glx:codeClass "refused_admission" ; glx:codeSource "engine" ;
    glx:codeDoc "The engine evaluated the admission steps and refused the input: at least one step (SHACL, N3, RDFS, OWL-RL, hooks) did not admit it." ;
    glx:brokenTerm "mu_on_O" ; glx:codeOrder 1 .

glx:CodePlanRefused a glx:RefusalCode ;
    glx:codeName "plan_refused" ; glx:codeClass "refused_admission" ; glx:codeSource "engine" ;
    glx:codeDoc "The engine's plan step refused: the submitted plan violates a precondition or goal it can verify against the data." ;
    glx:brokenTerm "mu_on_O" ; glx:codeOrder 2 .

glx:CodeReceiptRequired a glx:RefusalCode ;
    glx:codeName "receipt_required" ; glx:codeClass "refused_admission" ; glx:codeSource "engine" ;
    glx:codeDoc "A require_receipt step found no receipt for the required step, so the transition has no receipted admission behind it." ;
    glx:brokenTerm "mu_on_O" ; glx:codeOrder 3 .

glx:CodeLeaseRefused a glx:RefusalCode ;
    glx:codeName "lease_refused" ; glx:codeClass "refused_authority" ; glx:codeSource "engine" ;
    glx:codeDoc "The engine refused the supplied lease: it is unsigned, expired, outside the allowed clock skew, or signed by an untrusted key." ;
    glx:brokenTerm "R_missing_authority" ; glx:codeOrder 4 .

glx:CodeResourceLimit a glx:RefusalCode ;
    glx:codeName "resource_limit" ; glx:codeClass "blocked_resource" ; glx:codeSource "engine" ;
    glx:codeDoc "The engine hit a resource limit (input size, fuel, or memory) before it could decide; nothing was admitted or refused." ;
    glx:brokenTerm "R_missing_consequence" ; glx:codeOrder 5 .

glx:CodePolicyRefused a glx:RefusalCode ;
    glx:codeName "policy_refused" ; glx:codeClass "refused_admission" ; glx:codeSource "engine" ;
    glx:codeDoc "The engine refused the request under its policy: the requested authority ceiling or operation is not permitted." ;
    glx:brokenTerm "mu_on_O" ; glx:codeOrder 6 .

glx:CodeEngineRefused a glx:RefusalCode ;
    glx:codeName "engine_refused" ; glx:codeClass "refused_structure" ; glx:codeSource "engine" ;
    glx:codeDoc "The engine refused the request for a structural reason (malformed op, data, or steps) reported under its error kind." ;
    glx:brokenTerm "mu_on_O" ; glx:codeOrder 7 .

glx:CodeEngineUnclassified a glx:RefusalCode ;
    glx:codeName "engine_unclassified" ; glx:codeClass "unsupported" ; glx:codeSource "engine" ;
    glx:codeDoc "The engine returned a refusal variant this library does not know; it is carried verbatim and classified unsupported rather than guessed." ;
    glx:brokenTerm "R_missing_standing" ; glx:codeOrder 8 .

glx:CodeWasmNotVendored a glx:RefusalCode ;
    glx:codeName "wasm_not_vendored" ; glx:codeClass "blocked_resource" ; glx:codeSource "host" ;
    glx:codeDoc "No GraphLaw WASM binary exists at the resolved path; run mix ash_graphlaw.vendor to fetch the pinned release asset." ;
    glx:brokenTerm "R_missing_consequence" ; glx:codeOrder 9 .

glx:CodeWasmUnreadable a glx:RefusalCode ;
    glx:codeName "wasm_unreadable" ; glx:codeClass "blocked_resource" ; glx:codeSource "host" ;
    glx:codeDoc "The GraphLaw WASM file exists at the resolved path but could not be read." ;
    glx:brokenTerm "R_missing_consequence" ; glx:codeOrder 10 .

glx:CodeWasmInvalid a glx:RefusalCode ;
