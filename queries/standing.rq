# Standing vocabulary (closed, ordered). Standing is derived, never stored on the DSL.
PREFIX glx: <https://graphlaw.dev/ash#>

SELECT ?standing_name ?standing_doc ?standing_order
WHERE {
  ?standing a glx:Standing ;
    glx:standingName ?standing_name ;
    glx:standingDoc ?standing_doc ;
    glx:standingOrder ?standing_order .
}
ORDER BY ?standing_order
