    code = engine_code_to_code(engine_code, kind)

    refusal = new(code, string_or_nil(Map.get(error_map, "message")), Map.merge(error_details, details_map))

    %{
      refusal
      | kind: kind,
        engine: string_or_nil(Map.get(error_map, "engine", Map.get(details_map, "engine"))),
        dialect: string_or_nil(Map.get(error_map, "dialect", Map.get(details_map, "dialect"))),
        raw: error_map
