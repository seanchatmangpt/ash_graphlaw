---
to: test/test_helper.exs
sparql:
  project: |
    # Copyright 2026 ash_graphlaw contributors <https://github.com/seanchatmangpt/ash_graphlaw/graphs/contributors>
    # SPDX-License-Identifier: MIT
    # Single-row project pin table: package version, GraphLaw release/ABI/wasm pin, generator pins.
    # Feeds mix.exs, README, root API, ABI, manifest and test-helper templates.
    PREFIX glx: <https://graphlaw.dev/ash#>

    SELECT ?package_version ?graphlaw_version ?abi_version ?wasm_sha256 ?wasm_asset ?wasm_url ?marketplace_sha ?ggen_sha
    WHERE {
      ?project a glx:Project ;
        glx:packageVersion ?package_version ;
        glx:graphLawVersion ?graphlaw_version ;
        glx:abiVersion ?abi_version ;
        glx:wasmSha256 ?wasm_sha256 ;
        glx:wasmAsset ?wasm_asset ;
        glx:wasmUrl ?wasm_url ;
        glx:marketplaceSha ?marketplace_sha ;
        glx:ggenSha ?ggen_sha .
    }
    ORDER BY ?package_version
for_each: project
force: true
---
# SPDX-FileCopyrightText: 2026 ash_graphlaw contributors <https://github.com/seanchatmangpt/ash_graphlaw/graphs/contributors>
#
# SPDX-License-Identifier: MIT

# GENERATED by ggen from templates/test_helper.exs.tmpl -- edit the template, not this file.
#
# GraphLaw pin: {{ graphlaw_version }} (ABI {{ abi_version }}).
#
# Tests tagged `:wasm` execute the REAL pinned GraphLaw wasm engine. When the engine is
# absent (`mix ash_graphlaw.vendor` not yet run) or fails the digest pin, those tests are
# EXCLUDED with a NAMED, PRINTED reason. The engine is never stubbed: a stubbed engine
# would defeat the only thing the `:wasm` tests exist to establish. CI always vendors the
# wasm, so `:wasm` always runs there.
#
# `:slow` tests are excluded by default; run them with `mix test --include slow`.

excluded = [:slow]

wasm_path = AshGraphLaw.WasmConfig.wasm_path([])

wasm_verdict =
  case File.read(wasm_path) do
    {:error, reason} ->
      {:unavailable, "#{wasm_path} is not readable (#{inspect(reason)}); run `mix ash_graphlaw.vendor`"}

    {:ok, bytes} ->
      case AshGraphLaw.EngineLoad.admit(bytes, []) do
        {:ok, _admitted} -> :ok
        {:error, refusal} -> {:unavailable, "#{wasm_path} refused by the engine gate (#{refusal.code}): #{refusal.message}"}
      end
  end

excluded =
  case wasm_verdict do
    :ok ->
      excluded

    {:unavailable, reason} ->
      IO.puts(:stderr, "[wasm] EXCLUDING :wasm -- " <> reason)
      [:wasm | excluded]
  end

ExUnit.start(exclude: excluded)
